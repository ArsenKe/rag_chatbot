{
  "name": "royal-ecars-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && svelte-kit sync && vite build",
    "start": "node build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.8",
    "@sveltejs/kit": "^2.11.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/node": "^22.7.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "chart.js": "^4.5.1",
    "googleapis": "^181.0.0",
    "jose": "^5.9.3",
    "redis": "^6.2.1",
    "zod": "^3.23.8"
  }
}
